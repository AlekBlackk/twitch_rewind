{
  "manifest_version": 3,
  "name": "Twitch Rewind",
  "version": "1.1.0",
  "description": "Rewind live Twitch streams via the DVR playlist, even when the VOD is not published.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Twitch Rewind: перемотка эфира",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "background": { "service_worker": "src/background.js", "type": "module" },
  "permissions": ["activeTab", "scripting", "storage", "unlimitedStorage", "alarms", "downloads"],
  "host_permissions": [
    "https://gql.twitch.tv/*",
    "https://*.cloudfront.net/*",
    "https://sullygnome.com/*",
    "https://recent-messages.robotty.de/*",
    "https://7tv.io/*",
    "https://api.betterttv.net/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    { "resources": ["src/player/player.html"], "matches": ["https://www.twitch.tv/*"] }
  ]
}
